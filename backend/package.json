{
  "name": "grant-completeness-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "npm run db:generate && npm run db:deploy && node src/server.js",
    "start:production": "npm run db:generate && npm run db:deploy && node src/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:seed:deployed": "node prisma/seed.js",
    "lint": "eslint src test prisma scripts prisma.config.js eslint.config.js",
    "smoke:deployment": "node scripts/smoke-test.js",
    "test": "npm run test:node && npm run test:domain",
    "test:node": "node --import ./test/setup.js --test test/auth.test.js test/assessment.test.js test/analysis.test.js test/review.test.js test/review-summary.test.js test/ai.test.js test/cors.test.js",
    "test:domain": "vitest run test/domain"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "openai": "^7.28.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
